Host *
    User nixos
    LogLevel ERROR
    IdentityFile "~/ghq/github.com/k-wa-wa/nuage-cluster/.ssh/keys/nixos"

Host lb-1 192.168.5.201
    HostName 192.168.5.201

Host lb-2 192.168.5.202
    HostName 192.168.5.202

Host lb-3 192.168.5.203
    HostName 192.168.5.203

Host chaos-monitor 192.168.5.250
    HostName 192.168.5.250

Host egress-gateway 192.168.5.220
    HostName 192.168.5.220

Host lm-server 192.168.5.222
    HostName 192.168.5.222

Host bluray-extractor 192.168.5.240
    HostName 192.168.5.240

Host atelier 192.168.5.252
    HostName 192.168.5.252

Host pg-cluster-1 10.20.1.41
    HostName 10.20.1.41
    ProxyJump lb-1

Host pg-cluster-2 10.20.1.42
    HostName 10.20.1.42
    ProxyJump lb-1

Host pg-cluster-3 10.20.1.43
    HostName 10.20.1.43
    ProxyJump lb-1

Host swfs-cluster-1 10.20.1.61
    HostName 10.20.1.61
    ProxyJump lb-1

Host swfs-cluster-2 10.20.1.62
    HostName 10.20.1.62
    ProxyJump lb-1

Host swfs-cluster-3 10.20.1.63
    HostName 10.20.1.63
    ProxyJump lb-1

Host mainframe 10.20.1.90
    HostName 10.20.1.90
    ProxyJump lb-1

# 次の 2 つの Host に並べたホストは、リポジトリの .ssh/known_hosts で接続先を確かめる。ホストを足したらここにも足す。
# Host * に書かないのは、このファイルが ~/.ssh/config などから Include され、github.com など他の接続にも効いてしまうためである。
# Proxmox の 4 台は上に Host が無く、ssh -i .ssh/keys/pve-root root@<IP> で入る。
# ホスト鍵を作り直すと (scripts/gen-host-keys.sh)、ホストに新しい鍵が届くまでは入れない。その間は -o StrictHostKeyChecking=no を付ける。
Host lb-1 lb-2 lb-3 chaos-monitor egress-gateway lm-server bluray-extractor atelier pg-cluster-1 pg-cluster-2 pg-cluster-3 swfs-cluster-1 swfs-cluster-2 swfs-cluster-3 mainframe nuc-1 dm-1 server-1 server-2
    StrictHostKeyChecking yes
    UserKnownHostsFile "~/ghq/github.com/k-wa-wa/nuage-cluster/.ssh/known_hosts"

Host 192.168.5.201 192.168.5.202 192.168.5.203 192.168.5.250 192.168.5.220 192.168.5.222 192.168.5.240 192.168.5.252 10.20.1.41 10.20.1.42 10.20.1.43 10.20.1.61 10.20.1.62 10.20.1.63 10.20.1.90 192.168.5.21 192.168.5.23 192.168.5.25 192.168.5.26
    StrictHostKeyChecking yes
    UserKnownHostsFile "~/ghq/github.com/k-wa-wa/nuage-cluster/.ssh/known_hosts"
