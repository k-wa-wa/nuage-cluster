# ==============================================================================
# Cloudflare API トークン設定用ローカルファイル (secrets.local.yaml) 見本
# ==============================================================================
#
# 【使い方】
# 1. このファイルを同ディレクトリにコピーして secrets.local.yaml を作成する:
#    cp secrets.local.yaml.example secrets.local.yaml
# 2. 下記の cloudflare_api_token に実際のトークンを貼り付ける。
# 3. secrets.local.yaml は .gitignore に登録されており、Git にコミットされない。
#
# 【API トークン発行手順と必要スコープ】
# Tunnel (アカウント) と DNS (ゾーン) を両方管理するため、
# Cloudflare ダッシュボード右上アイコン -> [My Profile] -> [API Tokens]
# -> [Create Token] -> [Custom Token (Get started)] を選択し、以下のスコープを付与する:
#
# 1. Permissions (アクセス許可):
#    - Zone    | DNS               | Edit
#    - Zone    | Zone              | Read
#    - Account | Cloudflare Tunnel | Edit
#
# 2. Resources:
#    - Account Resources: 対象アカウント (または All accounts)
#    - Zone Resources:    Specific zone -> wpcapp.net (または All zones)
#
# 3. TTL (有効期限):
#    - 操作時のみ有効にするため、7日間などの期限を設定することを推奨。
# ==============================================================================

cloudflare_api_token: "your-cloudflare-api-token-here"
