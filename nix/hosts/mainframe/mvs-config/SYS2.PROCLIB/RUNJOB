//RUNJOB   PROC M=,L='SYS2.JCLLIB'
//*
//* SUBMIT MEMBER M OF JCL LIBRARY L TO THE INTERNAL READER.
//* STARTED BY ZTIMER (SYS2.CONTROL(ZTIMER)), E.G. (A NAME WITH
//* PERIODS MUST BE QUOTED ON THE START COMMAND)
//*   S RUNJOB,M=USAGERPT,L='NUAGE.USAGE.JCLLIB'
//*
//COPY     EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&L(&M),DISP=SHR
//SYSUT2   DD SYSOUT=(A,INTRDR)
